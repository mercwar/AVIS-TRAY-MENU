// ============================================================================
// RESOURCE IDENTIFIER MANIFEST MATRIX :: ECLIPSE SUITE / THE CYBORG CHRONICLES
// ============================================================================

#include <winres.h>

// Define core resource constants explicitly for the compiler
#define IDI_APP_ICON 101
#define AVIS_WM_TRAYICON (WM_USER + 100)

// 1. APPLICATION VISUAL ICON MAPPING
IDI_APP_ICON ICON "eclipse.ico"

// 2. OFFICIAL WINDOWS FILE VERSIONING INFRASTRUCTURE
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    5,1,0,0
 PRODUCTVERSION 5,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // Language: US English, Character Set: Unicode
        BEGIN
            VALUE "CompanyName",      "CVBGOD Engineering\0"
            VALUE "FileDescription",  "Eclipse JSON-Driven System Tray Launcher & Control Center\0"
            VALUE "FileVersion",      "5.1.0.0\0"
            VALUE "InternalName",     "eclipse\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Joseph Catalano. All rights reserved.\0"
            VALUE "OriginalFilename", "eclipse.exe\0"
            VALUE "ProductName",      "The Fire Gem Suite :: The Cyborg Chronicles\0"
            VALUE "ProductVersion",   "5.1\0"
            VALUE "Comments",         "Modular task orchestration and background process management tray utility.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END